# .env.example — template for ./.env (copy: `cp .env.example .env`).
# .env is git-ignored: real values never enter the repo. These are local-dev
# placeholders; any value works locally. Decided identities (db, schema, role
# names) are NOT variables — they live literal in compose.yaml, the bootstrap
# SQL, and flyway.conf; changing one is a committed decision.

# the bootstrap identity's (postgres) password — used by the container at init
POSTGRES_BOOTSTRAP_PASSWORD=bootstrap_local

# the migrator identity's password, as Flyway connects with it.
# COUPLING: must equal the migrator password set in
# infrastructure/postgres/init/bootstrap.sql (literal there until env-templating
# of init SQL is earned).
FLYWAY_MIGRATOR_PASSWORD=migrator_local

# host-side port for PostgreSQL — machine-local variance; defaults to 5432,
# uncomment only if 5432 is taken on your machine
#POSTGRES_PORT=5432