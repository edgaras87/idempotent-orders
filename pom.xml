<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.edge</groupId>
	<artifactId>idempotent-orders</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>idempotent-orders</name>
	<description>Correctness-driven idempotent order creation service</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<!--
		Dependency convention: every runtime starter is paired with its Boot 4
		"-test" companion in test scope. Dependencies enter only at the step or
		slice that earns them — nothing ahead of need.
	-->
	<dependencies>

		<!-- Operational visibility: health/info endpoints. /actuator/health is how
		     the running skeleton — and, once wired, its database connection — is
		     shown alive without any custom code. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Test companion: actuator endpoint support inside test contexts. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- The service's API surface: Spring MVC controllers on the embedded
		     server. The create-order endpoint — the boundary where the
		     idempotency guarantee is sold — lives on this stack. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Test companion: MVC test support (MockMvc, web-slice testing) plus
		     the core test kit (JUnit Jupiter, AssertJ, Spring Test). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Persistence: plain JDBC (JdbcClient) — SQL stays visible in the
		     project's code; structure is described once, in migrations. No ORM,
		     no entities, no second schema description, deliberately (log 0007).
		     No "-test" companion exists for JDBC: database access is verified
		     through Testcontainers integration tests against real PostgreSQL. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- The PostgreSQL wire driver — runtime scope: needed to run, never
		     compiled against. Version managed by the Boot parent. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Evidence harness (test infrastructure only). The principle carried
			into the test tier: something outside the app migrates; the app runs.
			The harness starts a throwaway PostgreSQL container, applies the one
			migrations home (infrastructure/flyway/migrations) itself, then boots
			the app context against it — the app under test stays exactly as
			shipped: no migration machinery, one identity's posture.
		-->

		<!-- Real PostgreSQL in tests — evidence runs against the real store,
		     never an in-memory substitute (the invariants live in PostgreSQL's
		     atomic primitives; a substitute would test a different database). -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- @ServiceConnection: Spring wires the test datasource from the
		     container field — no url/credentials duplicated in test config. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- TestRestTemplate's foundation: Boot 4 ships RestTemplateBuilder in
		     its own restclient module, which the resttestclient auto-config
		     introspects — without it the web test context fails to load (lived:
		     NoClassDefFoundError RestTemplateBuilder). Test scope only; the
		     application itself makes no outbound HTTP calls. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-restclient</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Flyway as a HARNESS tool, test scope only — the test-side applier
		     of the same migration files the compose one-shot applies to the
		     real ground. Deliberately never a runtime dependency (log 0007). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Flyway's PostgreSQL support module (required by flyway-core ≥10). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<!-- Spring Boot packaging: repackages the jar as an executable
			     application and provides the spring-boot:run dev loop. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Test execution: the project's integration tests are *IT.java and
			     run under the one standard command, ./mvnw test — so Surefire's
			     include set is widened to pick them up alongside unit tests. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>